{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Surf",
  "version": "0.1.0",
  "identifier": "com.surf.browser",
  "build": {
    "beforeDevCommand": "pnpm --filter @surf/ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @surf/ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Surf",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
