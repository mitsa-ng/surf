{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Surf",
  "version": "0.1.0",
  "identifier": "com.surf.browser",
  "build": {
    "beforeDevCommand": "pnpm --filter @surf/ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @surf/ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
