{
  "name": "surf",
  "private": true,
  "scripts": {
    "test": "cargo test --workspace && pnpm --filter @surf/ui test",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && pnpm --filter @surf/ui lint",
